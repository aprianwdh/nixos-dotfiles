{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
        "logo": {
            "source": "~/.config/fastfetch/ascii.txt",
            "type": "file",
            "padding": {
            "top": 1,
            "left":1,
            "right":0,
            "bottom":1
            },
            "color": {
                "1": "#b4befe",
                "2": "#cdd6f4"
            }
        },
    "display": {
        "color": {
            "keys": "#b4befe",
            "title": "#b4befe",
            "output": "#b4befe"
        },
        "separator": "  "
    },
    "modules": [
        {
            "type": "custom",
            "format": "╭───────────╮"
        },
        {
            "type": "os",
            "key": "│ {##b4befe}󰇅 os      {#keys}│"
        },
        {
            "type": "host",
            "key": "│ {##b4befe}󰒋 host    {#keys}│",
            "format":"nixos-btw"
        },
        {
            "type": "cpu",
            "key": "│ {##b4befe} cpu     {#keys}│",
            "format":"Intel 1005G1"
        },
        {
            "type": "gpu",
            "key": "│ {##b4befe}󰡨 gpu     {#keys}│",
            "format": "AEMDE ERTEX 18.000"
        },
        {
            "type": "wm",
            "key": "│ {##b4befe}󰨇 wm      {#keys}│"
        },
        {
            "type": "packages",
            "key": "│ {##b4befe} pkgs    {#keys}│",
            "format": "(nix)"
        },
        {
            "type": "shell",
            "key": "│ {##b4befe} shell   {#keys}│"
        },
        {
            "type": "kernel",
            "key": "│ {##b4befe}󰍛 kernel  {#keys}│"
        },
        {
            "type": "uptime",
            "key": "│ {##b4befe} uptime  {#keys}│",
            "format": "{2}h {3}m"
        },
        {
            "type": "command",
            "key": "│ {##b4befe}󰔟 age     {#keys}│",
            "text": "birth_install=$(stat -c %W /etc/nixos); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days"
        },
        {
            "type": "memory",
            "key": "│ {##b4befe} memory  {#keys}│"
        },
        {
            "type": "disk",
            "key": "│ {##b4befe}󰚩 root    {#keys}│",
            "folders": "/",
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "disk",
            "key": "│ {##b4befe}󱂵 home    {#keys}│",
            "folders": "/home",
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "custom",
            "format": "├───────────┤"
        },
        {
            "type": "colors",
            "key": "│ {##b4befe} colors  {#keys}│",
            "symbol": "circle"
        },
        {
            "type": "custom",
            "format": "╰───────────╯"
        }
    ]
}
