// Keybindings — mirrors the hyprland.lua binds.
// https://niri-wm.github.io/niri/Configuration:-Key-Bindings
binds {
    Mod+Return { spawn "foot"; }
    Mod+Q repeat=false { close-window; }
    Mod+E { spawn "thunar"; }
    Mod+F { fullscreen-window; }
    Mod+Tab { spawn "rofi" "-show" "drun"; }
    Mod+B { spawn "firefox"; }
    Mod+P { spawn-sh "grim -g \"$(slurp)\" - | swappy -f -"; }
    Mod+V { spawn-sh "cliphist list | rofi -dmenu -display-columns 2 | cliphist decode | wl-copy"; }
    Mod+Alt+Delete { spawn "wlogout"; }
    Mod+Escape repeat=false { toggle-overview; }


    // Focus columns — matches your left/right + A/S binds.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+A     { focus-column-left; }
    Mod+S     { focus-column-right; }

    // Column resize — closest equivalent to hyprscroller's colresize +-0.1.
    Mod+D       { set-column-width "+10%"; }
    Mod+Shift+D { set-column-width "-10%"; }

    // Workspace switch/move — Up/Down repurposed to match your Scroller-style setup
    // (this replaces niri's default Mod+Up/Down = focus window up/down in a column).
    Mod+Up   { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }

    // Workspaces 1-10 (0 = 10th, same mapping as your Lua loop).
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }

    // Scroll wheel workspace switching (niri default, matches mouse_down/mouse_up).
    Mod+WheelScrollDown { focus-workspace-down; }
    Mod+WheelScrollUp   { focus-workspace-up; }

    // Mod+LMB drag = move window, Mod+RMB drag = resize window —
    // this is built into niri automatically, no bind needed.

    // Multimedia keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%-"; }

    XF86AudioNext  allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPlay  allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev  allow-when-locked=true { spawn-sh "playerctl previous"; }
}
