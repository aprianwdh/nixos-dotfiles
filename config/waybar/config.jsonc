{
  "layer": "top",
  "position": "top",
  "spacing": 3,
  "height": 1,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,

  "modules-left": ["hyprland/workspaces","custom/cpucat","clock"],
  "modules-right": [
    "mpris",
    "wireplumber",
    "backlight",
    "battery",
    "network",
    "custom/power"
  ],
  "custom/tab": {
  "format": "[Z]",
  "on-click": "rofi -show drun"
},
  "hyprland/workspaces": {
    "persistent-workspaces":{
      // "*": [1, 2, 3, 4, 5, 6]
      "*":5
    },
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },

  "mpris": {
    "format": "  {artist} - {title} ",
    "format-paused": " 󰐊 {artist} - {title} ",
    "max-length": 37,
    "tooltip": true
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6
  },
"custom/cpucat": {
    "exec":"/home/enzwich/.config/waybar/scripts/catloop.sh"
},
  "wireplumber": {
    "scroll-step": 5,
    "format": " {icon} {volume}%",
    "format-muted": "󰝟 muted",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphones": "󰋋",
      "headset": "󰋎"
    }
  },

  "backlight": {
    "device": "intel_backlight",
    "format": " {icon} {percent}% ",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}% ",
    "format-charging": "󰂄 {capacity}% ",
    "format-plugged": "󱟦 {capacity}% ",
    "format-full": "󰁹 {capacity}% ",
    "format-icons": [
      "󰂎", "󰁺", "󰁻", "󰁼", "󰁽",
      "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
    ]
  },

  "clock": {
    "format": "{:%m/%d/%Y %H:%M} "
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  {ipaddr}/{cidr}",
    "tooltip-format": "󰩟  {ifname} via {gwaddr}",
    "format-linked": "󰈀  {ifname} (No IP)",
    "format-disconnected": "󰖪  Disconnected",
    "on-click": "foot nmtui"
},
"custom/power": {
    "format": "⏻",
    "on-click": "wlogout",
    "tooltip": false
}
}
